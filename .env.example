# LitReview — production configuration (copy to .env and fill in).
# NEVER commit the real .env.

# --- access control (M7) ---
# Non-empty → the whole app (UI + API) requires this code to log in.
# Rotating the code logs everyone out.
SURVEY_ACCESS_CODE=change-me-to-a-long-code

# --- LLM backend ---
# Real surveys on a server need the Anthropic API (the native file-bridge
# only works next to an interactive Claude Code session).
SURVEY_LLM_BACKEND=api
ANTHROPIC_API_KEY=

# --- academic APIs politeness ---
SURVEY_CONTACT_EMAIL=you@example.com

# --- self-hosted with a domain (docker compose --profile domain) ---
DOMAIN=litreview.example.com

# --- optional Part-E features (all off by default) ---
# SURVEY_RELIABILITY_SIGNALS=1
# SURVEY_DR_DEPTH=deep
# SURVEY_SOURCE_SCOUT=1
# SURVEY_DEPTH=practical
# SURVEY_ML_DB_ROUTING=1
# SURVEY_ML_WEB=1
